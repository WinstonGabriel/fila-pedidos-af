{
  "manifest_version": 3,
  "name": "Fila de Pedidos - Análise",
  "version": "5.3.1",
  "description": "Divide os pedidos em análise entre os analistas (intervalo de horário ou pilha), sincronizado entre todos. Chrome: painel lateral fixo. Opera GX: janela própria.",
  "action": {
    "default_title": "Fila de Pedidos",
    "default_icon": {
      "19": "icons/sidebar-19.png",
      "38": "icons/sidebar-38.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "sidebar_action": {
    "default_title": "Fila de Pedidos",
    "default_panel": "popup.html",
    "default_icon": {
      "19": "icons/sidebar-19.png",
      "38": "icons/sidebar-38.png"
    },
    "panel_width": 400
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://af.mateusmais.com.br/*",
    "https://*.supabase.co/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
